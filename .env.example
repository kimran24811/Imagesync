# Keep the actual key ONLY in your local .env or a hosting secret manager.
# Never commit, paste into a GitHub file, or screenshot a real Gemini API key.
# If your key was exposed in a screenshot, revoke it and create a replacement.
# AI Studio may inject secrets for its hosted environment; that does not
# automatically provide a key to the downloaded Windows application.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Free local vision option (no paid image-analysis API required):
# 1. Install https://ollama.com on the PC running SceneSync.
# 2. In Command Prompt: ollama pull gemma3:4b
# 3. Keep Ollama running; choose Auto Vision in SceneSync.
OLLAMA_HOST="http://127.0.0.1:11434"
OLLAMA_VISION_MODEL="gemma3:4b"

# Supported Gemini model IDs (verify access in AI Studio):
GEMINI_VISION_MODEL="gemini-3.5-flash-lite"
GEMINI_BLUEPRINT_MODEL="gemini-3.8-flash"
